# Copie este archivo como ".env" y ponga sus datos. El archivo .env NO se sube a GitHub.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=notaria

# Opcional: correo para "¿Olvidó su contraseña?" (ej. Gmail con contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=sucorreo@gmail.com
# SMTP_CONTRASENA=contrasena-de-aplicacion

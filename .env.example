# Copie este archivo como ".env" y ponga sus datos. El archivo .env NO se sube a GitHub.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=notaria

# Dirección del frontend en Vercel (para CORS). Vacío = permite cualquiera.
# FRONTEND_URL=https://sistema-notarial-frontend.vercel.app

# Correo (opcional) con la API de Brevo
# BREVO_API_KEY=xkeysib-...
# CORREO_REMITENTE=su-correo@gmail.com
